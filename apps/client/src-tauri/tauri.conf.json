{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "malim_chat",
  "version": "0.1.0",
  "identifier": "com.malimchat.app",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build:tauri", "frontendDist": "../../../dist" },
  "app": { "windows": [{ "title": "malim_chat", "width": 1100, "height": 760, "minWidth": 360, "minHeight": 600 }], "security": { "csp": "default-src 'self' http: https: tauri:; connect-src 'self' http: https: tauri:; img-src 'self' data: http: https:; style-src 'self' 'unsafe-inline';" } },
  "bundle": { "active": true, "targets": "all" }
}
