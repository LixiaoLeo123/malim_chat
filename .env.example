# Frontend build-time configuration (Vite). Copy values into a local
# .env.local (git-ignored) as needed; never commit real hosts here.
#
# API base URL. Leave unset/empty to use the same-origin /malim_chat_api
# path (web deployment). For the Android APK set it to the absolute API
# URL, e.g. VITE_API_URL=http://<host>/malim_chat_api
VITE_API_URL=

# Base path for the web deployment, e.g. VITE_BASE_PATH=/malim_chat/
VITE_BASE_PATH=/
